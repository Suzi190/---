<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 基础主题：深色 + 黑色窗口背景，杜绝启动白闪 -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#000000</item>
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">#4F8CFF</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- 全屏沉浸：内容铺满到状态栏 / 导航栏 / 刘海区 -->
    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>

        <!-- 注意：这里【不要】加 android:windowFullscreen。
             部分机型会因此把窗口限制在刘海区之外，顶部直接出一条纯黑边（上一版就是这么翻车的）。
             状态栏交给 MainActivity.hideSystemBars() 隐藏，配合 edge-to-edge 才能让内容真正铺到屏幕边缘。 -->

        <!-- 系统栏透明 + 关闭对比度遮罩：边缘滑动临时调出系统栏时不会出现灰条 -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- 关键：允许绘制到刘海(cutout)区域，否则刘海两侧会出现黑条 -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>

        <!-- 关闭系统栏对比度遮罩，避免状态栏区域被压一层灰 -->
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <!-- 启动屏：纯黑，与 Web 层 splash-screen.js 无缝衔接 -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:background">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

</resources>
